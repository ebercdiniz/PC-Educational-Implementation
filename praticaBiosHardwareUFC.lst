praticaBiosHardwareUFC.asm
                                ;---------------------------------------------
                                ; Mapa de I/O
                                ;
                                ; 10h  8251 Data
                                ; 12h  8251 Status/Control -> Usa o pino AD1 ao inves do AD0.
                                ; 20h  8255
                                ; 40h  8253 Counter 0
                                ; 42h  8253 Counter 1
                                ; 44h  8253 Counter 2
                                ; 46h  8253 Command
                                ; 80h  8259 Command INTA00
                                ; 82h  8259 Data INTA01
                                ;---------------------------------------------
                                ; Mapa de Memória
                                ; 00000h–003FFh	Interrupt Vector Table (IVT)
                                ; 00400h–004FFh	BIOS Data Area (BDA)
                                ; 00500h em diante RAM Convencional
                                ; E0000h–FFFFFh	128 kB BIOS ROM
                                ;---------------------------------------------


                                .8086
                                .model large

                                .LIST

                                ;------------------------------------------------------------------------
                                ;	PORTAR A BIOS DO XT 5150 DE ABR 1983 PARA O NOSSO HARDWARE	:
                                ;	AS ROTINAS DA BIOS SÃO SOMENTE INTERRUPÇÃO POR SOFTWARE  	:
                                ;	AS MODIFICAÇÕES FEITAS SERÃO PARA ADEQUAR ESSA BIOS AO		:
                                ;	NOSSO HARDWARE. ENDEREÇOS ABSOLUTOS DENTRO DO SEGMENTO		:
                                ;	DE CÓDIGO VIOLAM A ESTRUTURA E O DESIGN DA BIOS SEGUNDO		:
                                ;	A PRÓPRIA IBM							:
                                ;------------------------------------------------------------------------

                                ;----------------------------------------
                                ;		PORTOS			:
                                ;----------------------------------------
                                ;PORT_A		EQU	60H		; 8255 PORT A ADDR SEM UTILIZACAO
                                ;PORT_B		EQU	61H		; 8255 PORT B ADDR SEM UTILIZACAO
                                ;PORT_C		EQU	62H		; 8255 PORT C ADDR SEM UTILIZACAO
                                ;CMD_PORT	EQU	63H		; 8255 COMANDO SEM UTILIZACAO
 = 80                           INTA00		EQU	80H		; 8259 COMANDO
 = 82                           INTA01		EQU	82H		; 8259 DADOS
 = 20                           EOI		EQU	20H
 = 40                           TIMER		EQU	40H
 = 46                           TIM_CTL 	EQU	46H		; 8253 TIMER CONTROLE
 = 40                           TIMER0		EQU	40H		; 8253 CONTADOR 0
 = 1                            TMINT		EQU	01		; TIMER 0 INTR RECVD MASK
 = 8                            DMA08		EQU	08		; DMA STATUS REG PORT ADDR
 = 0                            DMA		EQU	00		; DMA CHANNEL 0 ADDRESS REG PORT ADDR
 = 540                          MAX_PERIOD	EQU	540H
 = 410                          MIN_PERIOD	EQU	410H
                                ;KBD_IN		EQU	60H		; TECLADO DATA IN ADDR PORT
                                ;KBDINT		EQU	02		; TECLADO MASCARA INTR
                                ;KB_DATA 	EQU	60H		; VARREDURA DO TECLADO CODIGO PORTA
                                ;KB_CTL		EQU	61H		; BITS DE CONTROLE PARA TECLADO

                                ;----------------------------------------
                                ;	 LOCALIZAÇÃO DAS INTERRUPÇÕES	:
                                ;----------------------------------------

00000000                        ABS0	SEGMENT AT 0
00000000                        STG_LOC0	LABEL	BYTE
                                	ORG	2*4
00000008                        NMI_PTR 	LABEL	WORD
                                	ORG	5*4
00000014                        INT5_PTR	LABEL	WORD
                                	ORG	8*4
00000020                        INT_ADDR	LABEL	WORD
00000020                        INT_PTR 	LABEL	DWORD
                                	ORG	10H*4
00000040                        VIDEO_INT	LABEL	WORD
                                	ORG	1DH*4
00000074                        PARM_PTR	LABEL	DWORD		; POINTER TO VIDEO PARMS
                                	ORG	18H*4
00000060                        BASIC_PTR	LABEL	WORD		; ENTRY POINT FOR CASSETTE BASIC
                                	ORG	01EH*4			; INTERRUPT 1EH
00000078                        DISK_POINTER	LABEL	DWORD
                                	ORG	01FH*4			; LOCATION OF POINTER
0000007C                        EXT_PTR LABEL	DWORD			; POINTER TO EXTENSION
                                	ORG	400H
00000400                        DATA_AREA	LABEL	BYTE		; ABSOLUTE LOCATION OF DATA SEGMENT
00000400                        DATA_WORD	LABEL	WORD
                                	ORG	0500H
00000500                        MFG_TEST_RTN	LABEL	FAR
                                	ORG	7C00H
00007C00                        BOOT_LOCN	LABEL	FAR
 = 0                            UART_OFFSET  	EQU	0000H
 = E000                         UART_SEGMENT 	EQU	0E000h

00007C00                        ABS0		ENDS

                                ;------------------------------------------------
                                ; STACK -- USED DURING INITIALIZATION ONLY	:
                                ;------------------------------------------------

00000000                        STACK	SEGMENT AT 30H
00000000  000000000000000000    	DW	128 DUP(?)
00000100                        TOS	LABEL	WORD
00000100                        STACK	ENDS

                                ;----------------------------------------
                                ;	ROM BIOS DATA AREAS		:
                                ;----------------------------------------

00000000                        DATA	SEGMENT AT 40H
00000000  0000000000000000      RS232_BASE	DW	4 DUP(?)	; ADDRESSES OF RS232 ADAPTERS
00000008  0000000000000000      PRINTER_BASE	DW	4 DUP(?)	; ADDRESSES OF PRINTERS
00000010  0000                  EQUIP_FLAG	DW	?		; INSTALLED HARDWARE
00000012  00                    MFG_TST 	DB	?		; INITIALIZATION FLAG
00000013  0000                  MEMORY_SIZE	DW	?		; MEMORY SIZE IN K BYTES


                                ;O MONTADOR ORIGINAL DA IBM ACEITA QUE DOIS LABELS DE TABELAS
                                ;REALOCAVEIS SEJA SOMADO (DATA_AREA[OFFSET MFG_ERR_FLAG] POR EX), 
                                ;MAS O JWASM NÃO. ENTÃO DEVEMOS MODIFICAR MFG_ERR_FLAG DE DB PARA
                                ;EQU
                                ;MFG_ERR_FLAG	DB	?		; SCRATCHPAD FOR MANUFACTURING
 = 15                           MFG_ERR_FLAG	EQU	15H		; SCRATCHPAD FOR MANUFACTURING

00000015  00                    		DB	?		; ERROR CODES

                                ;----------------------------------------
                                ;	KEYBOARD DATA AREAS		:
                                ;----------------------------------------

00000016  00                    KB_FLAG 	DB	?

                                ;----- SHIFT FLAG EQUATES WITHIN KB_FLAG

 = 80                           INS_STATE	EQU	80H		; INSERT STATE IS ACTIVE
 = 40                           CAPS_STATE	EQU	40H		; CAPS LOCK STATE HAS BEEN TOGGLED
 = 20                           NUM_STATE	EQU	20H		; NUM LOCK STATE HAS BEEN TOGGLED
 = 10                           SCROLL_STATE	EQU	10H		; SCROLL LOCK STATE HAS BEEN TOGGLED
 = 8                            ALT_SHIFT	EQU	08H		; ALTERNATE SHIFT KEY DEPRESSED
 = 4                            CTL_SHIFT	EQU	04H		; CONTROL SHIFT KEY DEPRESSED
 = 2                            LEFT_SHIFT	EQU	02H		; LEFT SHIFT KEY DEPRESSED
 = 1                            RIGHT_SHIFT	EQU	01H		; RIGHT SHIFT KEY DEPRESSED

00000017  00                    KB_FLAG_1	DB	?		; SECOND BYTE OF KEYBOARD STATUS

 = 80                           INS_SHIFT	EQU	80H		; INSERT KEY IS DEPRESSED
 = 40                           CAPS_SHIFT	EQU	40H		; CAPS LOCK KEY IS DEPRESSED
 = 20                           NUM_SHIFT	EQU	20H		; NUM LOCK KEY IS DEPRESSED
 = 10                           SCROLL_SHIFT	EQU	10H		; SCROLL LOCK KEY IS DEPRESSED
 = 8                            HOLD_STATE	EQU	08H		; SUSPEND KEY HAS BEEN TOGGLED

00000018  00                    ALT_INPUT	DB	?		; STORAGE FOR ALTERNATE KEYPAD ENTRY
00000019  0000                  BUFFER_HEAD	DW	?		; POINTER TO HEAD OF KEYBOARD BUFFER
0000001B  0000                  BUFFER_TAIL	DW	?		; POINTER TO TAIL OF KEYBOARD BUFFER
0000001D  000000000000000000    KB_BUFFER	DW	16 DUP(?)	; ROOM FOR 15 ENTRIES
0000003D                        KB_BUFFER_END	LABEL	WORD

                                ;------ HEAD = TAIL INDICATES THAT THE BUFFER IS EMPTY

 = 45                           NUM_KEY 	EQU	69		; SCAN CODE FOR NUMBER LOCK
 = 46                           SCROLL_KEY	EQU	70		; SCROLL LOCK KEY
 = 38                           ALT_KEY 	EQU	56		; ALTERNATE SHIFT KEY SCAN CODE
 = 1D                           CTL_KEY 	EQU	29		; SCAN CODE FOR CONTROL KEY
 = 3A                           CAPS_KEY	EQU	58		; SCAN CODE FOR SHIFT LOCK
 = 2A                           LEFT_KEY	EQU	42		; SCAN CODE FOR LEFT SHIFT
 = 36                           RIGHT_KEY	EQU	54		; SCAN CODE FOR RIGHT SHIFT
 = 52                           INS_KEY 	EQU	82		; SCAN CODE FOR INSERT KEY
 = 53                           DEL_KEY 	EQU	83		; SCAN CODE FOR DELETE KEY

                                ;----------------------------------------
                                ;	POST DATA AREA			:
                                ;----------------------------------------
0000003D  0000                  IO_ROM_INIT	DW	?		; PNTR TO OPTIONAL I/O ROM INIT ROUTINE
0000003F  0000                  IO_ROM_SEG	DW	?		; POINTER TO IO ROM SEGMENT
                                ;O MONTADOR ORIGINAL DA IBM ACEITA QUE DOIS LABELS DE TABELAS
                                ;REALOCAVEIS SEJA SOMADO(NOVAMENTE)
00000041  6B                    INTR_FLAG		DB	06BH		; FLAG TO INDICATE AN INTERRUPT HAPPEND
 = 41                           INTR_FLAG_OFFSET	EQU	041H		; FLAG TO INDICATE AN INTERRUPT HAPPEND


                                ;----------------------------------------
                                ;	TIMER DATA AREA 		:
                                ;----------------------------------------
00000042  0000                  TIMER_LOW	DW	?		; LOW WORD OF TIMER COUNT
00000044  0000                  TIMER_HIGH	DW	?		; HIGH WORD OF TIMER COUNT
00000046  00                    TIMER_OFL	DB	?		; TIMER HAS ROLLED OVER SINCE LAST READ
                                ;COUNTS_SEC	EQU	18
                                ;COUNTS_MIN	EQU	1092
                                ;COUNTS_HOUR	EQU	65543
                                ;COUNTS_DAY	EQU	1573040 = 1800B0H

                                ;----------------------------------------
                                ;	   SYSTEM DATA AREA		:
                                ;----------------------------------------
00000047  00                    BIOS_BREAK	DB	?		; BIT 7 = 1 IF BREAK KEY HAS BEEN HIT
00000048  0000                  RESET_FLAG	DW	?		; WORD = 1234H IF KEYBOARD RESET UNDERWAY
                                ;----------------------------------------
                                ;	  FIXED DISK DATA AREA		:
                                ;----------------------------------------
0000004A  0000                  		DW	?		;
0000004C  0000                  		DW	?		;

                                ;--------------------------------------------------------
                                ;	PRINTER AND RS232 TIME-OUT VARIABLES		:
                                ;--------------------------------------------------------
0000004E  00000000              PRINT_TIM_OUT	DB	4 DUP(?)
00000052  00000000              RS232_TIM_OUT	DB	4 DUP(?)
00000056                        DATA ENDS
                                ;----------------------------------------
                                ;	EXTRA DATA AREA 		:
                                ;----------------------------------------
00000000                        XXDATA	SEGMENT AT 50H
00000000  00                    STATUS_BYTE	DB	?
00000001                        XXDATA		ENDS


                                .CODE

                                ;----------------------------------------
                                ;	DATA DEFINITIONS		:
                                ;----------------------------------------

00000000  0000                  C1	DW	C11		; RETURN ADDRESS
                                ;C2	DW	C24		; RETURN ADDRESS FOR DUMMY STACK


                                ORG 0E0000h
000E0000                        uart_int:
000E0000  E410                      in  al,10h
000E0002  E610                      out 10h,al
000E0004  8807                      mov ds:[bx],al 
000E0006  83C302                    add bx,2
                                   ;finaliza a interrupcao	
000E0009  B020                      mov al,20h          
000E000B  E680                      out 80h,al
000E000D  CF                        iret


                                org 0F0000h

000F0000                        init_bios:
000F0000  8ED0                      mov ss,ax
000F0002  BC0004                    mov sp,0400h
000F0005  8EC0                      mov es,ax


000F0007                        init_8251:


                                ;---------------------------------------------
                                ; Parametrizar 8251
                                ;---------------------------------------------
                                    ; Resetar 8251
                                    ;Bit	Name	Value	Meaning
                                    ;D7	EH	0	Hunt mode disabled (sync mode only)
                                    ;D6	IR	1	Internal Reset
                                    ;D5	RTS	0	RTS inactive
                                    ;D4	ER	0	Reset error flags disabled
                                    ;D3	SBRK	0	Don't transmit BREAK
                                    ;D2	RxE	0	Receiver disabled
                                    ;D1	DTR	0	DTR inactive
                                    ;D0	TxEN	0	Transmitter disabled
000F0007  B040                      mov al,40h
000F0009  E612                      out 12h,al
000F000B  B040                      mov al,40h
000F000D  E612                      out 12h,al
000F000F  B040                      mov al,40h
000F0011  E612                      out 12h,al
000F0013  B040                      mov al,40h
000F0015  E612                      out 12h,al

                                    ; Datasheet do 8251A recomenda inclusao de wait states apos resetar.
                                    ;mov cx,1000
                                    ;delay:
                                    ;    loop delay

                                    ; 8-N-1 Baud 9600 para 5Mhz
                                    ;D1 D0	Meaning
                                    ;00	Synchronous
                                    ;01	×1
                                    ;10	×16
                                    ;11	×64
                                    ;D3 D2	Bits Character length
                                    ;00	5 bits
                                    ;01	6 bits
                                    ;10	7 bits
                                    ;11	8 bits
                                    ;D4
                                    ;Parity Enable
                                    ;0
                                    ;D5
                                    ;Even/Odd parity (1/0)
                                    ;X Don't care
                                    ;D7-D6
                                    ;Stop bits
                                    ;01 -> 1 stop bit
                                    ;10 -> 1.5 stop bits
                                    ;11 -> 2 stop bits
000F0017  B04E                      mov al,4eh
000F0019  E612                      out 12h,al

                                    ; Comando word
000F001B  B015                      mov al,15h
000F001D  E612                      out 12h,al



                                ;--------------------------------------------------------
                                ;	8253 TIMER CHECKOUT				:
                                ;DESCRIPTION						:
                                ;	VERIFY THAT THE SYSTEM TIMER (0) DOESN'T COUNT  :
                                ;	TOO FAST OR TOO SLOW.
                                ; COMENTADO PARA POSTERIOR AVALIACAO			:
                                ;--------------------------------------------------------
000F001F                        D7:
                                ;	MOV	DATA_AREA[OFFSET MFG_ERR_FLAG],02H
                                					; <><><><><><><><><><><><><><><><>
                                ;					; <><><>TIMER CHECKPOINT (2)<><><>
                                ;	MOV	AL,0FEH 		; MASK ALL INTRS EXCEPT LVL 0
                                ;	OUT	INTA01,AL		; WRITE THE 8259 IMR
                                ;	MOV	AL,00010000B		; SEL TIM 0, LSB, MODE 0, BINARY
                                ;	OUT	TIM_CTL,AL		; WRITE TIMER CONTROL MODE REG
                                ;	MOV	CX,16H			; SET PGM LOOP CNT
                                ;	MOV	AL,CL			; SET TIMER 0 CNT REG
                                ;	OUT	TIMER0,AL		; WRITE TIMER 0 CNT REG


                                ;--------------------------------------------------------
                                ;	INICIALIZAR 8259 PIC				:
                                ;--------------------------------------------------------
000F001F                        C25:

                                ;ICW1
                                ;Bit  Valor  Descricao
                                ;D4    1     Start Initialization - Vai configurar ICW4 na sequencia. O byte enviado agora é ICW1
                                ;D3    0     0 Edge triggered / 1 Level triggered
                                ;D2    0     Call address interval (ignored in 8086 mode) somente para 8080-8085.
                                ;D1    1     Single PIC (Pula ICW3)
                                ;D0    1     ICW4 will follow

000F001F  B013                  mov al,13h
000F0021  E680                  out INTA00,al

                                ;ICW2
                                ;Interrupt Vector Base (onde começa o vetor de interrupcao)
                                ;IRQ0 → INT 20h
                                ;IRQ1 → INT 21h
                                ;IRQ2 → INT 22h
                                ;...
                                ;IRQ7 → INT 27h
                                ;0x00 até 0x1F é reservado pela Intel (NMI, div por 0, etc...)
                                ;0x20 a 0x27 e usado pelo MS-DOS e pela IBM (caso queiramos portar nosso computador pra esse OS)

000F0023  B020                  mov al,20h
000F0025  E682                  out INTA01,al

                                ;ICW4
                                ;Bit  Valor  Descricao
                                ;D0     1    8086 mode 1 = 8086/8088 mode, 0 = 8080/8085 mode
                                ;D1     0    Normal EOI Automatic End Of Interrupt
                                ;D2     0    Master/slave when buffered disabled
                                ;D3     0    Buffered mode disabled
                                ;D4     0    Special Fully Nested Mode disabled

000F0027  B001                  mov al,01h
000F0029  E682                  out INTA01,al


                                ;OCW1(IMR)
                                ;11101111b = FDh habilita so o serial (IRQ4); Compativel com MS-DOS

000F002B  B0EF                  mov al,0EFh
000F002D  E682                  out INTA01,al

                                ;--------------------------------------------------------
                                ;	8259 INTERRUPT CONTROLLER TEST			:
                                ;DESCRIPTION						:
                                ;	READ/WRITE THE INTERRUPT MASK REGISTER (IMR)	:
                                ;	WITH ALL ONES AND ZEROES. ENABLE SYSTEM 	:
                                ;	INTERRUPTS.  MASK DEVICE INTERRUPTS OFF. CHECK	:
                                ;	FOR HOT INTERRUPTS (UNEXPECTED).		:
                                ;--------------------------------------------------------
                                	ASSUME	DS:ABS0
000F002F  1F                    C21:	POP	DS

                                ;----- TEST THE IMR REGISTER

000F0030  C606150005            C21A:	MOV	DATA_AREA[OFFSET MFG_ERR_FLAG],05H
                                					; <><><><><><><><><><><><>
                                					; <><><>CHECKPOINT 5<><><>
000F0035  B000                  	MOV	AL,0			; SET IMR TO ZERO
000F0037  E682                  	OUT	INTA01,AL
000F0039  E482                  	IN	AL,INTA01		; READ IMR
000F003B  0AC0                  	OR	AL,AL			; IMR = 0?
000F003D  7521                  	JNZ	D6			; GO TO ERR ROUTINE IF NOT 0
000F003F                        C21B:
000F003F  B0FF                  	MOV	AL,0FFH 		; DISABLE DEVICE INTERRUPTS
000F0041  E682                  	OUT	INTA01,AL		; WRITE TO IMR
000F0043  E682                  	OUT	INTA01,AL		; REPETIDO POIS ESTRANHAMENTE O IMR NAO CONSEGUE SER SETADO NO PRIMEIRO OUT
000F0045  E482                  	IN	AL,INTA01		; READ IMR
000F0047  0401                  	ADD	AL,1			; ALL IMR BITS ON?
000F0049  7515                  	JNZ	D6			; NO - GO TO ERR ROUTINE



                                ;----- CHECK FOR HOT INTERRUPTS

                                ;----- INTERRUPTS ARE MASKED OFF.  CHECK THAT NO INTERRUPTS OCCUR

000F004B  A24100                	MOV	DATA_AREA[INTR_FLAG_OFFSET],AL	; CLEAR INTERRUPT FLAG
000F004E  FB                    	STI				; ENABLE EXTERNAL INTERRUPTS
000F004F  2BC9                  	SUB	CX,CX			; WAIT 1 SEC FOR ANY INTRS THAT
000F0051                        D4:
000F0051  E2FE                  	LOOP	D4			; MIGHT OCCUR
000F0053                        D5:
000F0053  E2FE                  	LOOP	D5
000F0055  803E410000            	CMP	DATA_AREA[INTR_FLAG_OFFSET],00H ; DID ANY INTERRUPTS OCCUR?
000F005A  B0EF                  	MOV	AL,0EFH			; ATIVANDO APENAS A INTERRUPCAO SERIAL (IRQ4)
000F005C  E682                  	OUT	INTA01,AL
                                ;	JZ	D7			; NO - GO TO NEXT TEST
000F005E  7402                  	JZ	init_8253		; MODIFICADO. PULA PARA A CONFIGURACAO DO 8253
000F0060                        D6:
                                ;COMENTANDO POIS NÃO FOI IMPLEMENTADO AINDA
                                ;	MOV	SI,OFFSET E0		; DISPLAY 101 ERROR
                                ;	CALL	E_MSG
000F0060  FA                    	CLI
000F0061  F4                    	HLT				; HALT THE SYSTEM

                                ;--------------------------------------------------------
                                ;	INICIALIZAR 8253 PIT				:
                                ;--------------------------------------------------------
000F0062                        init_8253:

                                ;Bits			Descrição
                                ;D7–D6 (SC1:SC0)	Seleciona contador 0, 1 ou 2
                                ;D5–D4 (RW1:RW0)	Seleciona byte baixo, byte alto, ou byte baixo seguido de byte alto ou comando de latch da contagem atual
                                ;D3–D1 (M2:M0)		Seleciona o modo de contagem.
                                ;D0 (BCD)		0 seleciona contador binário; 1 seleciona contador BCD.

                                ; Configura Contador 0:
                                ; Mode 3, binary, low byte followed by high byte

000F0062  B036                  MOV AL, 36H	  ; Contador 0 Modo 3(Onda quadrada), contador binário
000F0064  E646                  OUT 46H, AL       ; Word de Controle

                                ;Carrega a contagem no Contador 0
000F0066  B00C                  MOV AL, 0CH      ; Byte baixo
000F0068  E640                  OUT 40H, AL

000F006A  B000                  MOV AL, 00H       ; Byte alto
000F006C  E640                  OUT 40H, AL

                                ;setando RxRDY para int24h
000F006E  B80000                    mov ax, UART_OFFSET
000F0071  89849000                  mov [si+90h], ax
000F0075  B800E0                    mov ax, UART_SEGMENT
000F0078  89849200                  mov [si+92h], ax
000F007C  FB                        sti


000F007D                        RESET	LABEL	FAR
000F007D  FA                    START:	CLI				; DISABLE INTERRUPTS
000F007E  B4D5                  	MOV	AH,0D5H 		; SET SF, CF, ZF, AND AF FLAGS ON
000F0080  9E                    	SAHF
000F0081  734C                  	JNC	ERR01			; GO TO ERR ROUTINE IF CF NOT SET
000F0083  754A                  	JNZ	ERR01			; GO TO ERR ROUTINE IF ZF NOT SET
000F0085  7B48                  	JNP	ERR01			; GO TO ERR ROUTINE IF PF NOT SET
000F0087  7946                  	JNS	ERR01			; GO TO ERR ROUTINE IF SF NOT SET
000F0089  9F                    	LAHF				; LOAD FLAG IMAGE TO AH
000F008A  B105                  	MOV	CL,5			; LOAD CNT REG WITH SHIFT CNT
000F008C  D2EC                  	SHR	AH,CL			; SHIFT AF INTO CARRY BIT POS
000F008E  733F                  	JNC	ERR01			; SO TO ERR ROUTINE IF AF NOT SET
000F0090  B040                  	MOV	AL,40H			; SET THE OF FLAG ON
000F0092  D0E0                  	SHL	AL,1			; SETUP FOR TESTING
000F0094  7139                  	JNO	ERR01			; GO TO ERR ROUTINE IF OF NOT SET
000F0096  32E4                  	XOR	AH,AH			; SET AH = 0
000F0098  9E                    	SAHF				; CLEAR SF, CF, ZF, AND PF
000F0099  7634                  	JBE	ERR01			; GO TO ERR ROUTINE IF CF ON
                                					; OR TO TO ERR ROUTINE IF ZF ON
000F009B  7832                  	JS	ERR01			; GO TO ERR ROUTINE IF SF ON
000F009D  7A30                  	JP	ERR01			; GO TO ERR ROUTINE IF PF ON
000F009F  9F                    	LAHF				; LOAD FLAG IMAGE TO AH
000F00A0  B105                  	MOV	CL,5			; LOAD CNT REG WITH SHIFT CNT
000F00A2  D2EC                  	SHR	AH,CL			; SHIFT AH INTO CARRY BIT POS
000F00A4  7229                  	JC	ERR01			; GO TO ERR ROUTINE IF ON
000F00A6  D0E4                  	SHL	AH,1			; CHECK THAT OF IS CLEAR
000F00A8  7025                  	JO	ERR01			; GO TO ERR ROUTINE IF ON

                                ;----- READ/WRITE THE 8088 GENERAL AND SEGMENTATION REGISTERS
                                ;      WITH ALL ONE'S AND ZEROES'S.

000F00AA  B8FFFF                	MOV	AX,0FFFFH		; SETUP ONE'S PATTERN IN AX
000F00AD  F9                    	STC
000F00AE  8ED8                  C8:	MOV	DS,AX			; WRITE PATTERN TO ALL REGS
000F00B0  8CDB                  	MOV	BX,DS
000F00B2  8EC3                  	MOV	ES,BX
000F00B4  8CC1                  	MOV	CX,ES
000F00B6  8ED1                  	MOV	SS,CX
000F00B8  8CD2                  	MOV	DX,SS
000F00BA  8BE2                  	MOV	SP,DX
000F00BC  8BEC                  	MOV	BP,SP
000F00BE  8BF5                  	MOV	SI,BP
000F00C0  8BFE                  	MOV	DI,SI
000F00C2  7307                  	JNC	C9			; TST1A
000F00C4  33C7                  	XOR	AX,DI			; PATTERN MAKE IT THRU ALL REGS
000F00C6  7507                  	JNZ	ERR01			; NO - GO TO ERR ROUTINE
000F00C8  F8                    	CLC
000F00C9  EBE3                  	JMP	C8
000F00CB                        C9:					; TST1A
000F00CB  0BC7                  	OR	AX,DI			; ZERO PATTERN MAKE IT THRU?
000F00CD  7401                  	JZ	C10			; YES - GO TO NEXT TEST
000F00CF  F4                    ERR01:	HLT				; HALT SYSTEM
                                ;----------------------------------------
                                ;	ROS CHECKSUM TEST I		:
                                ;DESCRIPTION				:
                                ;	A CHECKSUM IS DONE FOR THE 8K	:
                                ;	ROS MODULE CONTAINING POD AND	:
                                ;	BIOS.				:
                                ;----------------------------------------
000F00D0                        C10:
000F00D0  8CC8                  	MOV	AX,CS			; SETUP SS SEG REG
                                ;	MOV	SS,AX
000F00D2  8ED8                  	MOV	DS,AX			; SET UP DATA SEG TO POINT TO
                                					; ROM ADDRESS
000F00D4  FC                    	CLD				; SET DIRECTION FLAG TO INC.
                                ;	ASSUME	SS:CODE
000F00D5  BB00E0                	MOV	BX,0E000H		; SETUP STARTING ROS ADDR
                                ;	MOV	SP,OFFSET C1		; SETUP RETURN ADDRESS
000F00D8  BCFFFF                	MOV	SP,0FFFFh		; SETUP RETURN ADDRESS

000F00DB  EB02                  	JMP	ROS_CHECKSUM
000F00DD  75F0                  C11:	JNE	ERR01			; HALT SYSTEM IF ERROR


                                ;--------------------------------------------------------
                                ;	TIMER 1 FUNCTIONS OK. WRITE/READ THE CURRENT	:
                                ;	ADDRESS AND WORD COUNT REGISTERS FOR ALL	:
                                ;	CHANNELS.  INITIALIZE AND START DMA FOR MEMORY	:
                                ;	REFRESH.					:
                                ;--------------------------------------------------------
                                ;----------------------------------------
                                ;	ROS CHECKSUM SUBROUTINE 	:
                                ;----------------------------------------
000F00DF                        ROS_CHECKSUM	PROC	NEAR		; NEXT_ROS_MODULE
000F00DF  B9FF0F                	MOV	CX,0fffh 		; NUMBER OF BYTES TO ADD
000F00E2                        ROS_CHECKSUM_CNT:			; ENTRY FOR OPTIONAL ROS TEST
000F00E2  32C0                  	XOR	AL,AL
000F00E4                        C26:
000F00E4  0207                  	ADD	AL,DS:[BX]		;CHECA OS ÚLTIMOS 64KBYTES DA MEMORIA
000F00E6  43                    	INC	BX			; POINT TO NEXT BYTE
000F00E7  E2FB                  	LOOP	C26			; ADD ALL BYTES IN ROS MODULE
000F00E9  0AC0                  	OR	AL,AL			; SUM = 0?
000F00EB                        	RET

000F00EC  B800E0                	MOV AX,0E000H			; APONTANDO DS PARA E0000H
000F00EF  8ED8                  	MOV DS,AX
000F00F1  B9FF0F                	MOV	CX,0fffh 		; NUMBER OF BYTES TO ADD
000F00F4                        C26a:
000F00F4  0207                  	ADD	AL,DS:[BX]		;CHECA OS PRIMEIROS 64KBYTES DA MEMORIA
000F00F6  43                    	INC	BX			; POINT TO NEXT BYTE
000F00F7  E2FB                  	LOOP	C26a			; ADD ALL BYTES IN ROS MODULE
000F00F9  0AC0                  	OR	AL,AL			; SUM = 0?
000F00FB                        	RET

000F00FC                        ROS_CHECKSUM	ENDP

