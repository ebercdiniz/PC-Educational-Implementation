                                ;	VOLTA AO NOSSO CÓDIGO
                                ;--------------------------------------------------------
000F00FC  FB                    	STI				;ativa interrupcoes novamente

000F00FD                        loop_principal:
000F00FD  90                        nop
000F00FE  EBFD                      jmp     loop_principal


